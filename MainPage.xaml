<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndroidAutoMediaApp.MainPage"
             Title="Android Auto Music">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="Android Auto Music"
               FontSize="24"
               FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1" />
        <Label x:Name="StatusLabel"
               Text="Allow audio access to browse and play music stored on this device."
               SemanticProperties.Description="Audio library access status" />
        <Button Text="Allow audio access"
                Clicked="OnGrantAudioAccessClicked" />
    </VerticalStackLayout>
</ContentPage>
